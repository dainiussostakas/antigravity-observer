{
  "name": "antigravity-observer",
  "displayName": "Antigravity Observer",
  "description": "Display Google AI quota information",
  "version": "1.0.0",
  "publisher": "ds-labs",
  "repository": {
    "type": "git",
    "url": "https://github.com/dainiussostakas/antigravity-observer.git"
  },
  "engines": {
    "vscode": "^1.50.0"
  },
  "categories": [
    "Machine Learning"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "configuration": {
      "title": "Antigravity Observer",
      "properties": {
        "antigravity-observer.refreshRate": {
          "type": "number",
          "default": 60,
          "minimum": 10,
          "maximum": 3600,
          "markdownDescription": "Interval in seconds to refresh quota data. **Minimum: 10 seconds**",
          "editPresentation": "singlelineText",
          "order": 1
        },
        "antigravity-observer.selectedModels": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "markdownDescription": "Status bar QuickPick to select models.",
          "scope": "application",
          "order": 99
        }
      }
    },
    "commands": [
      {
        "command": "antigravity-quota.refresh",
        "title": "Refresh Quota"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "package": "node esbuild.js --production",
    "build": "vsce package --out dist/",
    "test": "npm run test:security",
    "test:security": "mocha -r ts-node/register src/test/security.test.ts",
    "test:vscode": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "18.x",
    "@types/vscode": "^1.50.0",
    "esbuild": "^0.27.3",
    "mocha": "^11.7.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.0.0"
  }
}